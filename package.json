{
    "name": "xrelay",
    "version": "0.2.4",
    "description": "Vercel Edge Function proxy with free proxy pool and fallback",
    "main": "api/index.ts",
    "type": "module",
    "scripts": {
        "dev": "vite --config config/vite.config.ts",
        "dev:api": "node server.js",
        "dev:standalone": "bun run src/standalone.ts",
        "build:frontend": "vite build --config config/vite.config.ts",
        "build:api": "tsc --project config/tsconfig.json --outDir dist",
        "build": "npm run build:frontend && npm run build:api",
        "build:binary": "bash scripts/build-binary.sh",
        "build:binary:linux-x64": "bash scripts/build-binary.sh --os linux --arch x64",
        "build:binary:linux-arm64": "bash scripts/build-binary.sh --os linux --arch arm64",
        "build:binary:macos-x64": "bash scripts/build-binary.sh --os macos --arch x64",
        "build:binary:macos-arm64": "bash scripts/build-binary.sh --os macos --arch arm64",
        "build:binary:windows-x64": "bash scripts/build-binary.sh --os windows --arch x64",
        "build:all": "npm run build:binary:linux-x64 && npm run build:binary:linux-arm64 && npm run build:binary:macos-x64 && npm run build:binary:macos-arm64 && npm run build:binary:windows-x64",
        "preview": "vite preview --config config/vite.config.ts",
        "deploy": "vercel --prod",
        "test": "vitest run --config tests/vitest.config.ts",
        "test:watch": "vitest --config tests/vitest.config.ts",
        "test:coverage": "vitest run --config tests/vitest.config.ts --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit --project config/tsconfig.json"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "dependencies": {
        "@extractus/article-extractor": "^8.1.0",
        "@sparticuz/chromium": "^149.0.0",
        "@types/turndown": "^5.0.6",
        "@vercel/edge": "^1.3.1",
        "@vercel/kv": "^3.0.0",
        "@vercel/postgres": "^0.10.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "defuddle": "^0.19.2",
        "diff": "^8.0.3",
        "esbuild": "^0.25.0",
        "path-to-regexp": "^6.3.0",
        "pg": "^8.22.0",
        "puppeteer-core": "^25.3.0",
        "stopword": "^3.1.5",
        "turndown": "^7.2.4",
        "undici": "^6.21.0",
        "vite": "^7.3.4",
        "vue": "^3.5.40"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "@types/pg": "^8.20.0",
        "@types/stopword": "^2.0.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.53.1",
        "@vercel/node": "^5.6.15",
        "@vitest/coverage-v8": "^4.1.10",
        "bun-types": "^1.3.10",
        "eslint-plugin-unused-imports": "^4.4.1",
        "puppeteer": "^25.3.0",
        "typescript": "^5.3.0",
        "vitest": "^4.1.0"
    },
    "overrides": {
        "sanitize-html": {
            "htmlparser2": "10.1.0"
        },
        "diff": "^8.0.3",
        "path-to-regexp": "^6.3.0",
        "tar": "^7.5.19",
        "undici": "^6.21.0",
        "esbuild": "^0.25.0",
        "minimatch": "^9.0.5",
        "semver": "^7.5.2",
        "debug": "^4.3.1",
        "ajv": "^8.18.0",
        "@tootallnate/once": "^3.0.0",
        "postcss": "^8.5.13",
        "smol-toml": "^1.6.1",
        "uuid": "^11.1.1",
        "picomatch": "^4.0.2",
        "js-yaml": "^4.3.0",
        "basic-ftp": "^5.3.1",
        "brace-expansion": "^5.0.8",
        "fast-uri": "^3.1.4",
        "flatted": "^3.4.2",
        "ip-address": "^10.1.1",
        "eslint": {
            "ajv": "^6.14.0"
        }
    }
}
