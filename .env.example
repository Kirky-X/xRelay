# =============================================================================
# xRelay 环境变量配置示例
# 复制为 .env 并填入真实值（生产环境务必使用强密钥）
# =============================================================================

# ---- API Key 配置 ----
# 启用 API Key 验证（true/false）
ENABLE_API_KEY=true

# API Keys（多个用逗号分隔）
# 示例: API_KEYS=key1,key2,key3
# 生产环境务必使用强随机串（>= 32 字符）
API_KEYS=your-secret-api-key-here

# API Key 请求头名称（默认: x-api-key）
API_KEY_HEADER=x-api-key

# ---- CORS 配置 ----
# 允许的跨域来源（逗号分隔）
# 生产环境务必显式配置为你的前端域名
# 示例: CORS_ORIGINS=https://your-frontend.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=https://vercel-proxy-shield.vercel.app

# ---- 服务器配置（独立部署 / Docker） ----
# 监听主机：默认 127.0.0.1（仅本机访问）
# Docker 容器内需设为 0.0.0.0（docker-compose.yml 已配置）
# 对外暴露应通过反向代理（nginx/Caddy）
HOST=127.0.0.1

# 监听端口（默认 3000）
PORT=3000

# ---- 定时任务配置 ----
# CRON 端点保护密钥（保护 /api/cron/cleanup 不被未授权触发）
# 生产环境必须配置（强随机串 >= 32 字符）
CRON_SECRET=your-cron-secret-min-32-chars-random

# ---- 数据库配置 ----
# PostgreSQL 数据库连接 URL（可选）
# 如果不配置，系统将使用内存模式
# 格式: postgresql://user:password@host:port/database
# Neon PostgreSQL 示例: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/xrelay

# Docker Compose 必需变量（运行 docker compose up 时需提供）
# 生产环境务必使用强密码（>= 32 字符随机串）
POSTGRES_USER=xrelay
POSTGRES_PASSWORD=CHANGE_ME_REQUIRED_strong_random_secret_min_32_chars
POSTGRES_DB=xrelay
REDIS_PASSWORD=CHANGE_ME_REQUIRED_another_strong_random_secret_min_32_chars

# ---- Vercel KV（可选，未配置时使用内存降级模式） ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- 功能开关 ----
# 缓存（默认开启）
ENABLE_CACHE=true
# 限流（默认开启）
ENABLE_RATE_LIMIT=true
# Fallback 直连（代理全失败时是否直连目标，默认开启）
ENABLE_FALLBACK=true
# 详细日志（生产环境应设为 false）
ENABLE_VERBOSE_LOGGING=false

# ---- 代理池配置（可选，覆盖默认值） ----
# 代理池刷新间隔（毫秒，默认 5 分钟）
# PROXY_POOL_REFRESH_INTERVAL=300000
# 代理池最小数量（默认 3）
# PROXY_POOL_MIN_COUNT=3
# 代理池最大数量（默认 10）
# PROXY_POOL_MAX_COUNT=10
