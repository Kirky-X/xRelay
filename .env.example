# API Key 配置
# 启用 API Key 验证（true/false）
ENABLE_API_KEY=true

# API Keys（多个用逗号分隔）
# 示例: API_KEYS=key1,key2,key3
API_KEYS=your-secret-api-key-here

# API Key 请求头名称（默认: x-api-key）
API_KEY_HEADER=x-api-key

# 数据库配置
# PostgreSQL 数据库连接 URL（可选）
# 如果不配置，系统将使用内存模式
# 格式: postgresql://user:password@host:port/database
# Neon PostgreSQL 示例: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/xrelay

# Docker Compose 必需变量（运行 docker compose up 时需提供）
# 生产环境务必使用强密码（>= 32 字符随机串）
POSTGRES_USER=xrelay
POSTGRES_PASSWORD=CHANGE_ME_REQUIRED_strong_random_secret_min_32_chars
POSTGRES_DB=xrelay
REDIS_PASSWORD=CHANGE_ME_REQUIRED_another_strong_random_secret_min_32_chars

# Vercel KV（可选，未配置时使用内存降级模式）
KV_REST_API_URL=
KV_REST_API_TOKEN=
